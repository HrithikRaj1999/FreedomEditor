		"button.secondaryBackground": "#36423E",
		"button.secondaryForeground": "#E0E9E4",
		"input.background": "#252D2B",
		"input.foreground": "#DFE5E3",
		"input.border": "#485650",
		"dropdown.background": "#252D2B",
		"list.activeSelectionBackground": "#29473E",
		"list.activeSelectionForeground": "#EDFAF3",
		"list.hoverBackground": "#28312E",
		"list.highlightForeground": "#8CECCA",
		"quickInput.background": "#202726",
		"terminal.ansiGreen": "#83D8A9",
		"terminal.ansiBlue": "#8AC3EB",
		"terminal.ansiYellow": "#E4C17D",
		"terminal.ansiRed": "#EE938B",
		"textLink.foreground": "#8ADBCD"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#93A49A", "fontStyle": "italic" } },
		{ "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#B2D795" } },
		{ "scope": ["keyword", "storage"], "settings": { "foreground": "#E9B980" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#88DCCC" } },
		{ "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#98C5F0" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#EBA8A0" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#93DFC1" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#E5CA94" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#FFFFFF", "background": "#963E46" } }
	]
}