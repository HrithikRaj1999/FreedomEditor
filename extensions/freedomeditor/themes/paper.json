	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#687D6E", "fontStyle": "italic" } },
		{ "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#527429" } },
		{ "scope": ["keyword", "storage"], "settings": { "foreground": "#98501D" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#086C65" } },
		{ "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#246897" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#AC4253" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#20735A" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8B621A" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#FFFFFF", "background": "#AF3E4C" } }
	]
}